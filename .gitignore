# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Python history (created by interactive REPL / ipython)
.python_history
.ipython/
.history

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── ChromaDB (auto-created at runtime) ───────────────────────────────────────
# ChromaDB creates this folder with SQLite + HNSW index files when the app runs
# It's your local vector DB — do NOT commit it (can be GBs for large datasets)
chroma_db/
*.sqlite3
*.chroma

# ── Node / React ──────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.pnp
.pnp.js

# Vite / CRA cache
.vite/
.cache/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Uploads / temp data ───────────────────────────────────────────────────────
# Don't commit raw stock data files accidentally
uploads/
temp/
*.csv.bak